/**
 * NGS Pipeline - Nextflow Configuration
 * 
 * This file contains all configuration options for the pipeline
 * including executor settings, resource limits, container options, etc.
 */

// ============================================================================
// MANIFEST
// ============================================================================

manifest {
    name        = 'NGS Pipeline'
    author      = 'NGS Pipeline Team'
    version     = '1.0.0'
    description = 'Next Generation Sequencing Analysis Pipeline'
    nextflowVersion = '!>=23.04.0'
    homePage    = 'https://github.com/ngs-pipeline/ngs-pipeline'
}

// ============================================================================
// PARAMETERS (with defaults, can be overridden via CLI)
// ============================================================================

params {
    // Input/Output
    input          = './data/*_{R1,R2}*.{fastq,fq,fastq.gz,fq.gz}'
    outdir         = './results'
    genome         = 'hg19'
    genome_dir     = './resources/genomes'
    sample_sheet   = ''
    
    // Processing options
    skip_qc        = false
    skip_trim      = false
    skip_align     = false
    skip_variants  = false
    skip_annotate  = false
    run_bqsr       = true
    
    // Tool selection (Biokart WES Pipeline defaults)
    trimmer        = 'cutadapt'        // cutadapt, fastp, trimmomatic
    quality_cutoff = 30                // Phred score cutoff Q30
    min_length     = 36
    adapter_r1     = 'AGATCGGAAGAGCACACGTCTGAACTCCAGTCA'
    adapter_r2     = 'AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT'
    aligner        = 'bwa'             // bwa (BWA-MEM), bowtie2
    variant_caller = 'gatk'            // gatk (HaplotypeCaller)
    annotator      = 'annovar'         // annovar, snpeff, vep
    annovar_dir    = ''
    annovar_protocols = 'refGene,avsnp150,1000g2015aug_all,exac03,clinvar_20221231,dbnsfp42a'
    annovar_operations = 'g,f,f,f,f,f'
    
    // Reference files
    fasta          = ''
    gtf            = ''
    dbsnp          = ''
    known_indels   = ''
    vep_cache      = ''
    bed            = ''
    
    // Resource limits
    max_cpus       = 16
    max_memory     = '64.GB'
    max_time       = '24.h'
    
    // Email notification
    email          = ''
    email_on_fail  = true
    
    // Publish mode
    publish_mode   = 'copy'            // copy, link, rellink, move
}

// ============================================================================
// EXECUTOR CONFIGURATION
// ============================================================================

executor {
    name = 'local'
    cpus = params.max_cpus
    memory = params.max_memory
    queueSize = 100
    pollInterval = 10
}

// ============================================================================
// PROCESS RESOURCE DEFINITIONS
// ============================================================================

process {
    // Default resources
    withLabel: 'qc' {
        cpus = 4
        memory = '8.GB'
        time = '2.h'
    }
    
    withLabel: 'trim' {
        cpus = 8
        memory = '16.GB'
        time = '4.h'
    }
    
    withLabel: 'index' {
        cpus = 8
        memory = '32.GB'
        time = '12.h'
    }
    
    withLabel: 'align' {
        cpus = 16
        memory = '32.GB'
        time = '12.h'
    }
    
    withLabel: 'variants' {
        cpus = 16
        memory = '64.GB'
        time = '24.h'
    }
    
    withLabel: 'annotate' {
        cpus = 8
        memory = '32.GB'
        time = '12.h'
    }
    
    withLabel: 'report' {
        cpus = 4
        memory = '8.GB'
        time = '1.h'
    }
    
    // Specific process overrides
    withName: 'BWA_INDEX' {
        cpus = 8
        memory = '32.GB'
        time = '12.h'
    }
    
    withName: 'BOWTIE2_INDEX' {
        cpus = 8
        memory = '32.GB'
        time = '12.h'
    }
    
    withName: 'GATK_HAPLOTYPECALLER' {
        cpus = 16
        memory = '64.GB'
        time = '24.h'
    }
    
    withName: 'GATK_GENOMICSDBIMPORT' {
        cpus = 16
        memory = '64.GB'
        time = '12.h'
    }
    
    withName: 'GATK_GENOTYPEGVCFS' {
        cpus = 8
        memory = '32.GB'
        time = '12.h'
    }
    
    withName: 'VEP' {
        cpus = 16
        memory = '64.GB'
        time = '24.h'
    }
    
    // Container definitions per process
    withName: 'FASTQC' {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }
    withName: 'CUTADAPT' {
        container = 'quay.io/biocontainers/cutadapt:4.4--py39hf95cd2a_1'
    }
    withName: 'FASTP' {
        container = 'quay.io/biocontainers/fastp:0.23.4--hadf994f_2'
    }
    withName: 'TRIMMOMATIC' {
        container = 'quay.io/biocontainers/trimmomatic:0.39--hdfd78af_2'
    }
    withName: 'BWA_INDEX' {
        container = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:21960a4acb7e3e414f43403865b6e3952e46b080-0'
    }
    withName: 'BWA_MEM' {
        container = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:21960a4acb7e3e414f43403865b6e3952e46b080-0'
    }
    withName: 'BOWTIE2_INDEX' {
        container = 'quay.io/biocontainers/mulled-v2-ac74a7f02cebcfcc07d8e8d1d75034c3772d7740:c5a31b997c64eb3747055e886d38e2ecad03f9b8-0'
    }
    withName: 'BOWTIE2' {
        container = 'quay.io/biocontainers/mulled-v2-ac74a7f02cebcfcc07d8e8d1d75034c3772d7740:c5a31b997c64eb3747055e886d38e2ecad03f9b8-0'
    }
    withName: 'MARKDUPLICATES' {
        container = 'broadinstitute/gatk:4.5.0.0'
    }
    withName: 'BQSR' {
        container = 'broadinstitute/gatk:4.5.0.0'
    }
    withName: 'GATK_HAPLOTYPECALLER' {
        container = 'broadinstitute/gatk:4.5.0.0'
    }
    withName: 'GATK_SELECTVARIANTS' {
        container = 'broadinstitute/gatk:4.5.0.0'
    }
    withName: 'GATK_VARIANTFILTRATION' {
        container = 'broadinstitute/gatk:4.5.0.0'
    }
    withName: 'COUNT_VARIANTS' {
        container = 'quay.io/biocontainers/bcftools:1.19--h8b25389_0'
    }
    withName: 'ANNOVAR' {
        container = 'python:3.11-slim'
    }
    withName: 'GENERATE_REPORT_TABLES' {
        container = 'python:3.11-slim'
    }
    withName: 'MULTIQC' {
        container = 'quay.io/biocontainers/multiqc:1.19--pyhdfd78af_0'
    }

    // Error handling
    errorStrategy = 'retry'
    maxRetries = 2
    maxErrors = -1
    
    // Container options (if using Docker/Singularity/Apptainer)
    containerOptions = '-u $(id -u):$(id -g)'
    
    // Stage files
    stageInMode = 'copy'
    stageOutMode = 'copy'
}

// ============================================================================
// CONTAINER CONFIGURATION
// ============================================================================

// Enable container engine
docker {
    enabled = true
    autoMounts = true
    runOptions = '-u $(id -u):$(id -g)'
}

// Apptainer (modern Singularity successor)
apptainer {
    enabled = false
    autoMounts = true
    cacheDir = './apptainer_cache'
    runOptions = '--cleanenv'
}

// Singularity
singularity {
    enabled = false
    autoMounts = true
    cacheDir = './singularity_cache'
    runOptions = '--cleanenv'
}

// ============================================================================
// PROFILES
// ============================================================================

profiles {
    // Standard local execution (Docker container engine)
    standard {
        process.executor = 'local'
        docker.enabled = true
        docker.autoMounts = true
    }
    
    // Explicit Docker profile
    docker {
        process.executor = 'local'
        docker.enabled = true
        docker.autoMounts = true
    }
    
    // Apptainer profile (HPC / rootless)
    apptainer {
        process.executor = 'local'
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = './apptainer_cache'
    }

    // Singularity profile
    singularity {
        process.executor = 'local'
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = './singularity_cache'
    }

    // Quadro Workstation Profile (High performance, multi-threaded, GPU workstation)
    quadro {
        process.executor = 'local'
        params.max_cpus = 32
        params.max_memory = '128.GB'
        docker.enabled = true
        docker.autoMounts = true
        docker.runOptions = '-u $(id -u):$(id -g) --ipc=host'
    }

    // Quadro Apptainer Profile (Quadro workstation with Apptainer / rootless)
    quadro_apptainer {
        process.executor = 'local'
        params.max_cpus = 32
        params.max_memory = '128.GB'
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = './apptainer_cache'
    }

    // High-memory local execution
    highmem {
        process.executor = 'local'
        docker.enabled = true
        docker.autoMounts = true
        process.memory = '128.GB'
        process.cpus = 32
    }
    
    // SLURM cluster
    slurm {
        process.executor = 'slurm'
        process.container = 'singularity'
        process.queue = 'normal'
        process.clusterOptions = '--account=myaccount --partition=normal'
    }
    
    // AWS Batch
    awsbatch {
        process.executor = 'awsbatch'
        process.container = 'docker'
        workDir = 's3://my-bucket/ngs-pipeline/work'
        process.queue = 'my-job-queue'
    }
    
    // Google Cloud Life Sciences
    gcp {
        process.executor = 'google-lifesciences'
        process.container = 'docker'
        workDir = 'gs://my-bucket/ngs-pipeline/work'
        process.zone = 'us-central1-a'
    }
    
    // Kubernetes
    k8s {
        process.executor = 'k8s'
        process.container = 'docker'
        k8s.namespace = 'ngs-pipeline'
        k8s.serviceAccount = 'ngs-pipeline'
    }
    
    // Test profile (minimal resources)
    test {
        process.executor = 'local'
        process.container = 'docker'
        process.cpus = 2
        process.memory = '4.GB'
        process.time = '30.min'
        params.max_cpus = 2
        params.max_memory = '4.GB'
        params.skip_qc = false
        params.skip_variants = false
    }
    
    // No containers (native installation)
    nocontainer {
        process.executor = 'local'
        docker.enabled = false
        singularity.enabled = false
    }
}

// ============================================================================
// REPORTING & NOTIFICATIONS
// ============================================================================

// Execution report
report.enabled = true
report.file = 'pipeline_report.html'
report.overwrite = true

// Timeline report
timeline.enabled = true
timeline.file = 'pipeline_timeline.html'
timeline.overwrite = true

// Trace report
trace.enabled = true
trace.file = 'pipeline_trace.txt'
trace.overwrite = true
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'

// DAG visualization
dag.enabled = true
dag.file = 'pipeline_dag.html'
dag.overwrite = true

// Email notification
workDir = './work'

// ============================================================================
// CUSTOM CONFIG INCLUDES
// ============================================================================

// Optional overrides can be enabled explicitly when those files are present:
// includeConfig 'config/local.config'
// includeConfig 'config/institutional.config'
